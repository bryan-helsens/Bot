# =============================================================================
# QuantBot — Voorbeeld-omgevingsconfiguratie
# -----------------------------------------------------------------------------
# Kopieer dit bestand naar `.env` en vul de waarden in:
#       cp .env.example .env
#
# Alle variabelen worden geladen via `quantbot.core.config.Settings`
# (pydantic-settings). Nested settings gebruiken een dubbele underscore als
# scheidingsteken, bijv. RISK__MAX_OPEN_TRADES.
#
# !! Commit NOOIT een ingevuld `.env`-bestand. Het staat in .gitignore. !!
# =============================================================================

# -----------------------------------------------------------------------------
# Algemeen
# -----------------------------------------------------------------------------
# Omgeving: development | staging | production
ENVIRONMENT=development
# Loglevel: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Logformaat: json (productie) | console (lokaal lezen)
LOG_FORMAT=console
# Tijdzone voor weergave (interne opslag is altijd UTC)
TIMEZONE=UTC
# Handelsmodus: live | paper | backtest
TRADING_MODE=paper

# -----------------------------------------------------------------------------
# Binance API
# -----------------------------------------------------------------------------
# Markt: spot | futures
BINANCE__MARKET=spot
# Gebruik het Binance testnet (sterk aanbevolen om mee te starten)
BINANCE__TESTNET=true
# API-credentials. In productie bij voorkeur via SecretsManager/secret-store
# i.p.v. platte tekst hier. Zie docs/USAGE.md (Security).
BINANCE__API_KEY=your_api_key_here
BINANCE__API_SECRET=your_api_secret_here
# Optioneel: expliciete REST/WS base-URLs overschrijven (leeg = auto o.b.v.
# market + testnet). Handig voor proxies of regionale endpoints.
BINANCE__REST_BASE_URL=
BINANCE__WS_BASE_URL=
# Ontvangstvenster voor getekende requests (ms)
BINANCE__RECV_WINDOW=5000
# Standaard hefboom voor futures (1 = geen hefboom). Spot negeert dit.
BINANCE__DEFAULT_LEVERAGE=1
# Marginmodus voor futures: isolated | cross
BINANCE__MARGIN_MODE=isolated

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Maximaal request-gewicht per minuut (Binance spot default = 6000;
# zet wat lager als veiligheidsmarge).
RATE_LIMIT__MAX_WEIGHT_PER_MINUTE=5500
# Maximaal aantal orders per 10s en per dag (Binance spot defaults).
RATE_LIMIT__MAX_ORDERS_PER_10S=45
RATE_LIMIT__MAX_ORDERS_PER_DAY=150000

# -----------------------------------------------------------------------------
# WebSocket
# -----------------------------------------------------------------------------
# Herverbind-backoff (seconden): start, max en factor.
WEBSOCKET__RECONNECT_INITIAL_DELAY=1.0
WEBSOCKET__RECONNECT_MAX_DELAY=60.0
WEBSOCKET__RECONNECT_FACTOR=2.0
# Ping-interval en timeout (seconden) voor heartbeat.
WEBSOCKET__PING_INTERVAL=20.0
WEBSOCKET__PING_TIMEOUT=10.0
# Maximale stilte voordat een stream als 'stale' geldt en REST-fallback start.
WEBSOCKET__STALE_TIMEOUT=90.0

# -----------------------------------------------------------------------------
# Trading-universum
# -----------------------------------------------------------------------------
# Komma-gescheiden lijst trading-pairs.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Komma-gescheiden timeframes: 1m,3m,5m,15m,30m,1h,4h,12h,1d
TIMEFRAMES=15m,1h,4h
# Quote-asset waarin balans/PnL wordt uitgedrukt.
QUOTE_ASSET=USDT
# Pad naar het YAML-bestand met actieve strategieën.
STRATEGIES_CONFIG=config/strategies.yaml

# -----------------------------------------------------------------------------
# Signaal-aggregatie (confluence)
# -----------------------------------------------------------------------------
# Minimum aantal overeenstemmende strategieën voordat er gehandeld wordt.
AGGREGATOR__MIN_CONSENSUS=2
# Minimale gecombineerde (gesommeerde) signaalsterkte. Eén stem per strategie;
# de som kan dus groter dan 1.0 zijn (bv. 2 strategieën à 0.6 => 1.2).
AGGREGATOR__MIN_STRENGTH=0.5
# Tijdvenster (seconden) waarbinnen signalen als gelijktijdig tellen.
AGGREGATOR__WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Risicobeheer
# -----------------------------------------------------------------------------
# Sizing-methode: fixed | risk | kelly | volatility
RISK__SIZING_METHOD=risk
# Risico per trade als fractie van de equity (0.01 = 1%).
RISK__RISK_PER_TRADE=0.01
# Kelly-fractie-cap (bescherming tegen over-betting), 0..1.
RISK__KELLY_CAP=0.25
# Standaard stop-loss / take-profit als fractie van entryprijs.
RISK__DEFAULT_STOP_LOSS_PCT=0.02
RISK__DEFAULT_TAKE_PROFIT_PCT=0.04
# Trailing stop-afstand (fractie). 0 = uit.
RISK__TRAILING_STOP_PCT=0.015
# Activeer break-even stop nadat deze winstfractie is bereikt. 0 = uit.
RISK__BREAK_EVEN_TRIGGER_PCT=0.01
# Meerdere take-profit-niveaus: "prijs_fractie:positie_fractie" komma-gescheiden.
# Voorbeeld: 0.02:0.5,0.04:0.3,0.06:0.2
RISK__TAKE_PROFIT_LEVELS=0.02:0.5,0.04:0.3,0.06:0.2
# Limieten op posities en exposure.
RISK__MAX_OPEN_TRADES=5
RISK__MAX_EXPOSURE_PER_COIN=0.20
RISK__MAX_PORTFOLIO_EXPOSURE=0.60
# Verlieslimieten als fractie van de equity (handel stopt bij overschrijding).
RISK__MAX_DAILY_LOSS=0.05
RISK__MAX_WEEKLY_LOSS=0.10
RISK__MAX_DRAWDOWN=0.20
# Correlatiecontrole: blokkeer nieuwe positie als correlatie met bestaande
# posities boven deze drempel ligt (Pearson, 0..1). 1 = uit.
RISK__MAX_CORRELATION=0.80
RISK__CORRELATION_LOOKBACK=200
# Circuit breaker: pauzeer X seconden na N opeenvolgende verliezen.
RISK__CIRCUIT_BREAKER_LOSSES=4
RISK__CIRCUIT_BREAKER_COOLDOWN=3600
# Noodstop: sluit alle posities en stop volledig.
RISK__EMERGENCY_STOP_ENABLED=true
# Verbied gevaarlijke patronen (hard afgedwongen).
RISK__ALLOW_MARTINGALE=false
RISK__ALLOW_UNLIMITED_AVERAGING=false
RISK__MAX_AVERAGING_ENTRIES=3

# -----------------------------------------------------------------------------
# Backtesting / simulatie
# -----------------------------------------------------------------------------
# Startkapitaal voor paper/backtest (in QUOTE_ASSET).
BACKTEST__INITIAL_CAPITAL=10000
# Commissie per zijde als fractie (Binance taker spot ~0.001).
BACKTEST__COMMISSION=0.001
# Slippage als fractie van de prijs.
BACKTEST__SLIPPAGE=0.0005
# Spread-simulatie als fractie (bid/ask helft).
BACKTEST__SPREAD=0.0002

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=quantbot
DATABASE__USER=quantbot
DATABASE__PASSWORD=change_me
# Alternatief: volledige DSN (overschrijft bovenstaande velden indien gezet).
# Formaat: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE__DSN=
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__ECHO=false

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=
# Alternatief: volledige URL (overschrijft bovenstaande velden indien gezet).
# Formaat: redis://:password@host:port/db
REDIS__URL=

# -----------------------------------------------------------------------------
# API (FastAPI monitoring-backend)
# -----------------------------------------------------------------------------
API__ENABLED=true
API__HOST=0.0.0.0
API__PORT=8000
# Geheim voor JWT-ondertekening (genereer: openssl rand -hex 32).
API__JWT_SECRET=change_me_use_a_long_random_secret
API__JWT_EXPIRE_MINUTES=1440
# Komma-gescheiden toegestane CORS-origins (dashboard-URL).
API__CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Fernet-sleutel voor encryptie van credentials at rest.
# Genereer: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY__ENCRYPTION_KEY=
# Schakel onveranderlijke audit-logging in.
SECURITY__AUDIT_ENABLED=true

# -----------------------------------------------------------------------------
# Notificaties
# -----------------------------------------------------------------------------
NOTIFICATIONS__ENABLED=true
# Minimale ernst die een melding triggert: info | warning | error | critical
NOTIFICATIONS__MIN_SEVERITY=info

# Telegram
NOTIFICATIONS__TELEGRAM_ENABLED=false
NOTIFICATIONS__TELEGRAM_BOT_TOKEN=
NOTIFICATIONS__TELEGRAM_CHAT_ID=

# Discord
NOTIFICATIONS__DISCORD_ENABLED=false
NOTIFICATIONS__DISCORD_WEBHOOK_URL=

# Email (SMTP)
NOTIFICATIONS__EMAIL_ENABLED=false
NOTIFICATIONS__EMAIL_SMTP_HOST=smtp.gmail.com
NOTIFICATIONS__EMAIL_SMTP_PORT=587
NOTIFICATIONS__EMAIL_USERNAME=
NOTIFICATIONS__EMAIL_PASSWORD=
NOTIFICATIONS__EMAIL_FROM=
NOTIFICATIONS__EMAIL_TO=

# -----------------------------------------------------------------------------
# AI / Machine Learning (optioneel)
# -----------------------------------------------------------------------------
AI__ENABLED=false
# Map waarin getrainde modellen worden opgeslagen/geladen.
AI__MODEL_DIR=models
# Minimale model-confidence (0..1) voordat een AI-signaal wordt doorgegeven.
AI__MIN_CONFIDENCE=0.6
# Aantal walk-forward-folds voor validatie.
AI__WALK_FORWARD_FOLDS=5
