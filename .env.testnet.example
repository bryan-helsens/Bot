# =============================================================================
# QuantBot — TESTNET-configuratie (echte koersen, NEPGELD)
# -----------------------------------------------------------------------------
# Kant-en-klaar voor live order-uitvoering op het Binance SPOT-testnet.
# Gebruik:
#     cp .env.testnet.example .env
#     cp config/strategies.paper.example.yaml config/strategies.yaml
#     # vul hieronder je twee testnet-keys in, daarna:
#     python scripts/test_testnet.py --order --paper   # preflight, moet groen zijn
#     quantbot run                                       # start de bot
#
# NEPGELD: BINANCE__TESTNET=true → alles draait op testnet.binance.vision met
# gratis test-USDT (faucet). Er staat NOOIT echt geld op het spel.
# !! Commit dit bestand NOOIT met ingevulde keys. .env staat in .gitignore. !!
# =============================================================================

# --- Modus -------------------------------------------------------------------
# live  = orders gaan ECHT naar de testnet-beurs (meest realistisch).
# paper = fills lokaal gesimuleerd (zet op 'paper' als je dat liever eerst doet).
TRADING_MODE=live
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Binance testnet ---------------------------------------------------------
BINANCE__MARKET=spot
BINANCE__TESTNET=true
# >>> VUL HIER JE TESTNET-KEYS IN (van https://testnet.binance.vision) <<<
BINANCE__API_KEY=PLAK_HIER_JE_TESTNET_API_KEY
BINANCE__API_SECRET=PLAK_HIER_JE_TESTNET_API_SECRET
BINANCE__RECV_WINDOW=5000
# Live op MAINNET zou deze opt-in vereisen; op testnet niet nodig (nepgeld):
ALLOW_LIVE_REAL_ORDERS=false

# --- Handelsuniversum --------------------------------------------------------
# Breed universum (~60): large-caps, mid-caps, DeFi, L2's, meme + goedkope coins.
# De engine slaat symbolen die het testnet niet kent automatisch over
# (log: warmup_skip_symbol) en handelt de rest. Bij het opstarten waarschuwt hij
# ook welke coins een te hoge minimum-ordergrootte hebben voor je kapitaal
# (log: symbols_below_min_notional).
# Coin toevoegen/weghalen? Pas ALLEEN deze regel aan (de strategie pakt ze
# automatisch op omdat config/strategies.yaml symbols: [] gebruikt).
# Curated ~32 liquid large/mid-caps. Dropped pure memes (SHIB/PEPE/FLOKI/BONK/WIF)
# and the thinnest names: live data showed they bled (VET -1.01, BONK -0.69,
# ZIL/SHIB ~-0.5 each) — wide spreads + violent moves kill spot mean-reversion.
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,TRXUSDT,LTCUSDT,LINKUSDT,DOTUSDT,AVAXUSDT,ATOMUSDT,NEARUSDT,UNIUSDT,BCHUSDT,ETCUSDT,XLMUSDT,FILUSDT,APTUSDT,ARBUSDT,OPUSDT,INJUSDT,AAVEUSDT,POLUSDT,ICPUSDT,HBARUSDT,SUIUSDT,SEIUSDT,TIAUSDT,RUNEUSDT,FETUSDT
TIMEFRAMES=5m,15m
QUOTE_ASSET=USDT
STRATEGIES_CONFIG=config/strategies.yaml
# Persist cash/positions/equity so a restart resumes seamlessly. Empty = disabled.
STATE_FILE=data/state.json

# --- Signaal-aggregatie ------------------------------------------------------
AGGREGATOR__MIN_CONSENSUS=1
AGGREGATOR__MIN_STRENGTH=0.5
AGGREGATOR__WINDOW_SECONDS=60

# --- Risico (bewust KLEIN beginnen) ------------------------------------------
# Stop EN take-profit op 2,5% (1:1 reward/risk). Live testnet-data toonde dat de
# oude 3% stop / 2% TP een win rate van 60%+ vereiste om break-even te draaien;
# in een vlakke markt zakte de win rate naar 56% en werd de week negatief. Met
# 1:1 ligt de break-even win rate op ~50%, ruim onder de live win rate (56-74%).
RISK__SIZING_METHOD=risk
RISK__RISK_PER_TRADE=0.003
RISK__DEFAULT_STOP_LOSS_PCT=0.025
RISK__TRAILING_STOP_PCT=0.05
RISK__BREAK_EVEN_TRIGGER_PCT=0.0
RISK__TAKE_PROFIT_LEVELS=0.025:1.0
# Bigger basket -> more (small) concurrent positions. Per-position notional is
# ~risk/stop = 0.003/0.03 = 10% of equity, so up to ~8 fit under the 80% cap.
RISK__MAX_OPEN_TRADES=8
# Let positions run to TP/SL/trailing instead of closing on every opposite signal.
# The signal-flip exits were tiny round-trips that bled ~44% of gross profit in fees.
# Set to true only if you want the old flip-on-signal behaviour back.
RISK__EXIT_ON_OPPOSITE_SIGNAL=false
# After a losing exit on a coin, wait this long before re-entering it (anti
# revenge-trade). Live data showed coins re-bought and stopped out 3-4x in a row.
RISK__REENTRY_COOLDOWN_SECONDS=1800
RISK__MAX_EXPOSURE_PER_COIN=0.20
RISK__MAX_PORTFOLIO_EXPOSURE=0.80
RISK__MAX_DAILY_LOSS=0.05
RISK__MAX_WEEKLY_LOSS=0.10
RISK__MAX_DRAWDOWN=0.20
RISK__MAX_CORRELATION=0.80
RISK__CIRCUIT_BREAKER_LOSSES=4
RISK__CIRCUIT_BREAKER_COOLDOWN=3600
RISK__EMERGENCY_STOP_ENABLED=true
RISK__ALLOW_MARTINGALE=false
RISK__ALLOW_UNLIMITED_AVERAGING=false

# --- Start-testbalans / kosten-simulatie -------------------------------------
# In paper-mode is dit de interne startbalans; in live-mode komt je echte
# testnet-balans (faucet) uit get_account, en wordt dit de risk-baseline-fallback.
BACKTEST__INITIAL_CAPITAL=100
BACKTEST__COMMISSION=0.001
BACKTEST__SLIPPAGE=0.0005
BACKTEST__SPREAD=0.0002

# --- Dashboard / API ---------------------------------------------------------
# `quantbot serve` draait bot + dashboard op poort 8000. Bind op localhost en
# bekijk via een SSH-tunnel (ssh -L 8000:localhost:8000 user@vps) — veilig op een
# server. Voor publieke toegang: ENVIRONMENT=production + sterk API__JWT_SECRET.
API__HOST=127.0.0.1
API__PORT=8000
# Dashboard-login. Standaard (leeg wachtwoord + change_me secret) staat auth UIT,
# handig achter je SSH-tunnel op testnet. ZET DIT AAN vóór je het dashboard publiek
# maakt of naar ECHT geld gaat: vul een sterk wachtwoord + willekeurig secret in.
#   API__DASHBOARD_USER=admin
#   API__DASHBOARD_PASSWORD=kies-een-sterk-wachtwoord
#   API__JWT_SECRET=plak-hier-een-lange-willekeurige-string
NOTIFICATIONS__ENABLED=false
