# =============================================================================
# QuantBot — TESTNET-configuratie (echte koersen, NEPGELD)
# -----------------------------------------------------------------------------
# Kant-en-klaar voor live order-uitvoering op het Binance SPOT-testnet.
# Gebruik:
#     cp .env.testnet.example .env
#     cp config/strategies.paper.example.yaml config/strategies.yaml
#     # vul hieronder je twee testnet-keys in, daarna:
#     python scripts/test_testnet.py --order --paper   # preflight, moet groen zijn
#     quantbot run                                       # start de bot
#
# NEPGELD: BINANCE__TESTNET=true → alles draait op testnet.binance.vision met
# gratis test-USDT (faucet). Er staat NOOIT echt geld op het spel.
# !! Commit dit bestand NOOIT met ingevulde keys. .env staat in .gitignore. !!
# =============================================================================

# --- Modus -------------------------------------------------------------------
# live  = orders gaan ECHT naar de testnet-beurs (meest realistisch).
# paper = fills lokaal gesimuleerd (zet op 'paper' als je dat liever eerst doet).
TRADING_MODE=live
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Binance testnet ---------------------------------------------------------
BINANCE__MARKET=spot
BINANCE__TESTNET=true
# >>> VUL HIER JE TESTNET-KEYS IN (van https://testnet.binance.vision) <<<
BINANCE__API_KEY=PLAK_HIER_JE_TESTNET_API_KEY
BINANCE__API_SECRET=PLAK_HIER_JE_TESTNET_API_SECRET
BINANCE__RECV_WINDOW=5000
# Live op MAINNET zou deze opt-in vereisen; op testnet niet nodig (nepgeld):
ALLOW_LIVE_REAL_ORDERS=false

# --- Handelsuniversum --------------------------------------------------------
# Brede mix: large-caps + meme + goedkope coins. De engine slaat symbolen die het
# testnet niet kent automatisch over (log: warmup_skip_symbol) en handelt de rest.
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,TRXUSDT,LTCUSDT,DOGEUSDT,SHIBUSDT,PEPEUSDT,FLOKIUSDT
TIMEFRAMES=5m,15m
QUOTE_ASSET=USDT
STRATEGIES_CONFIG=config/strategies.yaml

# --- Signaal-aggregatie ------------------------------------------------------
AGGREGATOR__MIN_CONSENSUS=1
AGGREGATOR__MIN_STRENGTH=0.5
AGGREGATOR__WINDOW_SECONDS=60

# --- Risico (bewust KLEIN beginnen) ------------------------------------------
RISK__SIZING_METHOD=risk
RISK__RISK_PER_TRADE=0.004
RISK__DEFAULT_STOP_LOSS_PCT=0.03
RISK__TRAILING_STOP_PCT=0.05
RISK__BREAK_EVEN_TRIGGER_PCT=0.0
RISK__TAKE_PROFIT_LEVELS=0.02:1.0
# More coins in the basket -> allow more (small) concurrent positions to watch.
RISK__MAX_OPEN_TRADES=5
RISK__MAX_EXPOSURE_PER_COIN=0.20
RISK__MAX_PORTFOLIO_EXPOSURE=0.50
RISK__MAX_DAILY_LOSS=0.05
RISK__MAX_WEEKLY_LOSS=0.10
RISK__MAX_DRAWDOWN=0.20
RISK__MAX_CORRELATION=0.80
RISK__CIRCUIT_BREAKER_LOSSES=4
RISK__CIRCUIT_BREAKER_COOLDOWN=3600
RISK__EMERGENCY_STOP_ENABLED=true
RISK__ALLOW_MARTINGALE=false
RISK__ALLOW_UNLIMITED_AVERAGING=false

# --- Start-testbalans / kosten-simulatie -------------------------------------
# In paper-mode is dit de interne startbalans; in live-mode komt je echte
# testnet-balans (faucet) uit get_account, en wordt dit de risk-baseline-fallback.
BACKTEST__INITIAL_CAPITAL=10000
BACKTEST__COMMISSION=0.001
BACKTEST__SLIPPAGE=0.0005
BACKTEST__SPREAD=0.0002

# --- API/monitoring (optioneel) ----------------------------------------------
API__ENABLED=false
NOTIFICATIONS__ENABLED=false
