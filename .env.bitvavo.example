# =============================================================================
# QuantBot — BITVAVO-configuratie (EU/België: makkelijk storten via SEPA/Bancontact)
# -----------------------------------------------------------------------------
# Gebruik:
#     cp .env.bitvavo.example .env
#     cp config/strategies.paper.example.yaml config/strategies.yaml
#     # vul hieronder je Bitvavo API-keys in, daarna:
#     quantbot serve
#
# ⚠️ BELANGRIJK: Bitvavo heeft GEEN testnet. Daarom staat TRADING_MODE hier op
# `paper`: echte marktdata, maar orders worden LOKAAL gesimuleerd — er kan geen
# echt geld bewegen. LIVE op Bitvavo is ALTIJD echt geld en vereist bewust
# ALLOW_LIVE_REAL_ORDERS=true (doe dat pas na weken groene paper-resultaten).
# !! Commit dit bestand NOOIT met ingevulde keys. .env staat in .gitignore. !!
# =============================================================================

# --- Modus -------------------------------------------------------------------
TRADING_MODE=paper
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Exchange: Bitvavo -------------------------------------------------------
EXCHANGE=bitvavo
# >>> VUL HIER JE BITVAVO-KEYS IN (bitvavo.com -> API-instellingen) <<<
# Rechten: alleen "View" + "Trade" — NOOIT "Withdraw". Zet een IP-whitelist.
BITVAVO__API_KEY=PLAK_HIER_JE_BITVAVO_API_KEY
BITVAVO__API_SECRET=PLAK_HIER_JE_BITVAVO_API_SECRET
ALLOW_LIVE_REAL_ORDERS=false

# --- Handelsuniversum (EUR-paren!) --------------------------------------------
# Bitvavo noteert tegen EUR. Zelfde curated basket als op Binance, in EUR-paren.
# Onbekende paren worden bij het opstarten netjes overgeslagen (warmup_skip_symbol).
SYMBOLS=BTCEUR,ETHEUR,SOLEUR,XRPEUR,ADAEUR,DOGEEUR,LTCEUR,LINKEUR,DOTEUR,AVAXEUR,ATOMEUR,NEAREUR,UNIEUR,BCHEUR,ETCEUR,XLMEUR,FILEUR,APTEUR,ARBEUR,OPEUR,INJEUR,AAVEEUR,ICPEUR,HBAREUR,SUIEUR,SEIEUR,TIAEUR,FETEUR
TIMEFRAMES=5m,15m
QUOTE_ASSET=EUR
STRATEGIES_CONFIG=config/strategies.yaml
STATE_FILE=data/state.json

# --- Signaal-aggregatie ------------------------------------------------------
AGGREGATOR__MIN_CONSENSUS=1
AGGREGATOR__MIN_STRENGTH=0.5
AGGREGATOR__WINDOW_SECONDS=60

# --- Risico (identiek aan de bevroren lange-termijnconfig) ---------------------
RISK__SIZING_METHOD=risk
RISK__RISK_PER_TRADE=0.003
RISK__DEFAULT_STOP_LOSS_PCT=0.025
RISK__TRAILING_STOP_PCT=0.05
RISK__BREAK_EVEN_TRIGGER_PCT=0.0
RISK__TAKE_PROFIT_LEVELS=0.025:1.0
RISK__MAX_OPEN_TRADES=8
RISK__EXIT_ON_OPPOSITE_SIGNAL=false
RISK__REENTRY_COOLDOWN_SECONDS=1800
RISK__MAX_EXPOSURE_PER_COIN=0.20
RISK__MAX_PORTFOLIO_EXPOSURE=0.80
RISK__MAX_DAILY_LOSS=0.05
RISK__MAX_WEEKLY_LOSS=0.10
RISK__MAX_DRAWDOWN=0.20
RISK__MAX_CORRELATION=0.80
RISK__CIRCUIT_BREAKER_LOSSES=4
RISK__CIRCUIT_BREAKER_COOLDOWN=3600
RISK__EMERGENCY_STOP_ENABLED=true
RISK__ALLOW_MARTINGALE=false
RISK__ALLOW_UNLIMITED_AVERAGING=false

# --- Startkapitaal / kosten-simulatie ------------------------------------------
# Paper-mode: interne startbalans in EUR. Bitvavo taker-fee is ~0,25% — bewust
# HOGER ingesteld dan Binance (0,1%) zodat de simulatie eerlijk blijft.
BACKTEST__INITIAL_CAPITAL=100
BACKTEST__COMMISSION=0.0025
BACKTEST__SLIPPAGE=0.0005
BACKTEST__SPREAD=0.0002

# --- Dashboard / API ---------------------------------------------------------
API__HOST=127.0.0.1
API__PORT=8000
#   API__DASHBOARD_USER=admin
#   API__DASHBOARD_PASSWORD=kies-een-sterk-wachtwoord
#   API__JWT_SECRET=plak-hier-een-lange-willekeurige-string
NOTIFICATIONS__ENABLED=false
